# Copy to ".env.local" for local dev. On Vercel/hosting, add the SAME keys in
# Project → Settings → Environment Variables (Production + Preview).

NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production

# Optional; defaults to 2025-05-01 in lib/sanity.client.ts
# NEXT_PUBLIC_SANITY_API_VERSION=2025-05-01

# --- Blog editing (no localhost required) ---
# 1. Open https://www.sanity.io/manage → your project → Studio
# 2. Create documents of type "Blog Post" (post): title, slug, cover image, date, body
# 3. After first deploy of schema from this repo, run once on your machine:
#    npm install && npm run sanity:schema-deploy
#    (uses NEXT_PUBLIC_* from .env.local; deploys "post" schema to your dataset)
